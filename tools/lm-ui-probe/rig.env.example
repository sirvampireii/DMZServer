# Copy to tools/lm-ui-probe/rig.env (gitignored) and point at your rig folders. Keep them somewhere durable
# (not a temp folder): the prepared server and client dirs take a long time to rebuild.
export RIG_SERVER=/c/DMZRig/server          # prepared Forge 1.20.1-47.4.10 server dir (libraries/, win_args.txt)
export RIG_CLIENT=/c/DMZRig/client          # probe client game dir (wiped each run)
export RIG_KAIPATH_JAR=/c/DMZRig/kai/kaipath-1.5.6.jar   # read only, never modified
export RIG_LIVECFG=/c/DMZRig/livecfg        # legacymechanics.json and dragonminez/ copied from the live server
export RIG_EXTRA_MODS="/c/DMZRig/mods/dmzultra-0.5.7-noscale-placefix-podfix.jar /c/DMZRig/mods/dmzrevamp-2.2.4.jar"
export RIG_SERVER_ONLY="/c/DMZRig/mods/kiprobe.jar"
export RIG_OUT=/c/DMZRig/results
# Build inputs for release-check.sh
export DMZULTRA_JAR=/c/Users/antho/Documents/DMZServer/mods/dmzultra-0.2.9.jar
